// Hatian database schema. See docs/data-model.md for the reasoning.
//
// Money rule: every amount is an integer in minor units (centavos for PHP),
// stored next to its ISO 4217 currency code. Never floats.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js ─────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  memberships     GroupMember[]
  groupsCreated   Group[]       @relation("GroupCreatedBy")
  invitesCreated  GroupInvite[]
  expensesCreated Expense[]     @relation("ExpenseCreatedBy")
  paymentsCreated Payment[]     @relation("PaymentCreatedBy")
  activities      Activity[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Groups ──────────────────────────────────────────────────────────────────

model Group {
  id            String   @id @default(cuid())
  name          String
  icon          String   @default("users") // lucide icon name
  currency      String   @default("PHP") @db.Char(3)
  simplifyDebts Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy  User          @relation("GroupCreatedBy", fields: [createdById], references: [id])
  members    GroupMember[]
  invites    GroupInvite[]
  expenses   Expense[]
  payments   Payment[]
  activities Activity[]
}

enum GroupRole {
  OWNER
  MEMBER
}

/// A person in a group. Expenses, shares and payments point at members, not
/// users, so a friend can be added by name before they have an account
/// (`userId` null, a "placeholder") and claim that member later through the
/// invite link, keeping their history.
model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  /// Null until a real account joins as (or claims) this member.
  userId     String?
  /// Name shown in the group. For placeholders it's the only name there is.
  name       String
  role       GroupRole @default(MEMBER)
  /// Fixed palette slot so a member keeps their avatar colour.
  colorIndex Int
  createdAt  DateTime  @default(now())
  /// When an account joined or claimed this member.
  joinedAt   DateTime?
  /// Members with history are never deleted, only marked as removed.
  removedAt  DateTime?

  group            Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  expensesPaid     Expense[]      @relation("ExpensePaidBy")
  shares           ExpenseShare[]
  paymentsSent     Payment[]      @relation("PaymentFrom")
  paymentsReceived Payment[]      @relation("PaymentTo")

  /// One member per account per group (several placeholders may have no user).
  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvite {
  id          String    @id @default(cuid()) // used as the invite token
  groupId     String
  createdById String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([groupId])
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model Category {
  id       String    @id // stable slug, e.g. "food"
  name     String
  icon     String // lucide icon name
  expenses Expense[]
}

enum SplitMode {
  EQUAL
  SHARES
  PERCENT
  EXACT
}

model Expense {
  id               String    @id @default(cuid())
  groupId          String
  description      String
  categoryId       String?
  date             DateTime  @db.Date
  /// Amount in the group's currency, minor units.
  amount           Int
  currency         String    @db.Char(3)
  /// Set only when the expense was entered in another currency.
  originalAmount   Int?
  originalCurrency String?   @db.Char(3)
  /// Units of group currency per 1 unit of original currency.
  rate             Decimal?  @db.Decimal(18, 8)
  /// GroupMember who paid.
  paidById         String
  splitMode        SplitMode @default(EQUAL)
  note             String?
  receiptUrl       String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// Soft delete so the activity log and undo keep working.
  deletedAt        DateTime?

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category  Category?      @relation(fields: [categoryId], references: [id])
  // Member references never cascade: a member with history can't be deleted
  // on its own. Deleting a whole group removes expenses and payments first
  // (see deleteGroup), because Postgres checks these per cascade step.
  paidBy    GroupMember    @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: NoAction)
  createdBy User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  shares    ExpenseShare[]

  @@index([groupId, date])
}

model ExpenseShare {
  expenseId String
  memberId  String
  /// Input that produced the share: share count (SHARES), basis points
  /// (PERCENT, 10000 = 100%), 1 (EQUAL), or the amount itself (EXACT).
  weight    Int
  /// Final share in minor units. Shares of an expense always sum to its amount.
  amount    Int

  expense Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  GroupMember @relation(fields: [memberId], references: [id], onDelete: NoAction)

  @@id([expenseId, memberId])
  @@index([memberId])
}

// ─── Payments ────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  BANK
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  groupId     String
  /// GroupMember who paid.
  fromId      String
  /// GroupMember who received.
  toId        String
  amount      Int
  currency    String        @db.Char(3)
  method      PaymentMethod @default(CASH)
  reference   String?
  date        DateTime      @db.Date
  createdById String
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from      GroupMember @relation("PaymentFrom", fields: [fromId], references: [id], onDelete: NoAction)
  to        GroupMember @relation("PaymentTo", fields: [toId], references: [id], onDelete: NoAction)
  createdBy User        @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([groupId, date])
}

// ─── Activity ────────────────────────────────────────────────────────────────

enum ActivityType {
  GROUP_CREATED
  GROUP_UPDATED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  EXPENSE_RESTORED
  PAYMENT_RECORDED
  PAYMENT_DELETED
  PAYMENT_RESTORED
  MEMBER_ADDED
  MEMBER_JOINED
  MEMBER_REMOVED
}

model Activity {
  id        String       @id @default(cuid())
  groupId   String
  /// The signed-in user who did it.
  actorId   String
  type      ActivityType
  /// Expense, payment or member id, depending on `type`.
  entityId  String?
  /// Snapshots: { before?, after? }. See src/server/services/activity.ts.
  diff      Json?
  createdAt DateTime     @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([groupId, createdAt])
}

// ─── Currency ────────────────────────────────────────────────────────────────

/// Cache of Frankfurter rates (one row per pair per day).
model CurrencyRate {
  base      String   @db.Char(3)
  quote     String   @db.Char(3)
  date      DateTime @db.Date
  rate      Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime @default(now())

  @@id([base, quote, date])
}
