// Hatian database schema. See docs/data-model.md for the reasoning.
//
// Money rule: every amount is an integer in minor units (centavos for PHP),
// stored next to its ISO 4217 currency code. Never floats.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js ─────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  memberships      GroupMember[]
  groupsCreated    Group[]        @relation("GroupCreatedBy")
  invitesCreated   GroupInvite[]
  expensesPaid     Expense[]      @relation("ExpensePaidBy")
  expensesCreated  Expense[]      @relation("ExpenseCreatedBy")
  shares           ExpenseShare[]
  paymentsSent     Payment[]      @relation("PaymentFrom")
  paymentsReceived Payment[]      @relation("PaymentTo")
  paymentsCreated  Payment[]      @relation("PaymentCreatedBy")
  activities       Activity[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Groups ──────────────────────────────────────────────────────────────────

model Group {
  id            String   @id @default(cuid())
  name          String
  icon          String   @default("users") // lucide icon name
  currency      String   @default("PHP") @db.Char(3)
  simplifyDebts Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy  User          @relation("GroupCreatedBy", fields: [createdById], references: [id])
  members    GroupMember[]
  invites    GroupInvite[]
  expenses   Expense[]
  payments   Payment[]
  activities Activity[]
}

enum GroupRole {
  OWNER
  MEMBER
}

model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupInvite {
  id          String    @id @default(cuid()) // used as the invite token
  groupId     String
  createdById String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([groupId])
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model Category {
  id       String    @id // stable slug, e.g. "food"
  name     String
  icon     String // lucide icon name
  expenses Expense[]
}

enum SplitMode {
  EQUAL
  SHARES
  PERCENT
  EXACT
}

model Expense {
  id          String    @id @default(cuid())
  groupId     String
  description String
  categoryId  String?
  date        DateTime  @db.Date
  /// Amount in the group's currency, minor units.
  amount      Int
  currency    String    @db.Char(3)
  /// Set only when the expense was entered in another currency.
  originalAmount   Int?
  originalCurrency String?  @db.Char(3)
  /// Units of group currency per 1 unit of original currency.
  rate             Decimal? @db.Decimal(18, 8)
  paidById    String
  splitMode   SplitMode @default(EQUAL)
  note        String?
  receiptUrl  String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete so the activity log and undo keep working.
  deletedAt   DateTime?

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category  Category?      @relation(fields: [categoryId], references: [id])
  paidBy    User           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  createdBy User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  shares    ExpenseShare[]

  @@index([groupId, date])
}

model ExpenseShare {
  expenseId String
  userId    String
  /// Input that produced the share: share count (SHARES), basis points
  /// (PERCENT, 10000 = 100%), 1 or 0 (EQUAL), or the amount itself (EXACT).
  weight    Int
  /// Final share in minor units. Shares of an expense always sum to its amount.
  amount    Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
  @@index([userId])
}

// ─── Payments ────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  BANK
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  groupId     String
  fromId      String
  toId        String
  amount      Int
  currency    String        @db.Char(3)
  method      PaymentMethod @default(CASH)
  reference   String?
  date        DateTime      @db.Date
  createdById String
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from      User  @relation("PaymentFrom", fields: [fromId], references: [id])
  to        User  @relation("PaymentTo", fields: [toId], references: [id])
  createdBy User  @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([groupId, date])
}

// ─── Activity ────────────────────────────────────────────────────────────────

enum ActivityType {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  PAYMENT_RECORDED
  PAYMENT_DELETED
  MEMBER_JOINED
  GROUP_UPDATED
}

model Activity {
  id        String       @id @default(cuid())
  groupId   String
  actorId   String
  type      ActivityType
  entityId  String?
  /// { before, after } for edits; a snapshot for creates and deletes.
  diff      Json?
  createdAt DateTime     @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([groupId, createdAt])
}

// ─── Currency ────────────────────────────────────────────────────────────────

/// Cache of Frankfurter rates (one row per pair per day).
model CurrencyRate {
  base      String   @db.Char(3)
  quote     String   @db.Char(3)
  date      DateTime @db.Date
  rate      Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime @default(now())

  @@id([base, quote, date])
}
