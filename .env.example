# Postgres connection string.
# Neon: copy the direct (not pooled) connection string from the Neon dashboard.
# Migrations need a direct connection; a pooled URL for the app comes in phase 4.
# Local without Docker: `pnpm db:local` prints a URL you can paste here
# (PGlite-based: run e2e with --workers=1 and restart it if connections drop).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js. Generate a secret with `npx auth secret` or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
AUTH_SECRET=""

# Optional until deploy. Without these, magic links print to the terminal (dev only).
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Hatian <login@example.com>"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required outside Vercel (e.g. `pnpm start` locally, CI, Railway).
AUTH_TRUST_HOST="true"

# Set to "false" to hide the "Try the demo account" button.
AUTH_DEMO_ENABLED="true"
