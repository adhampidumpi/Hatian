# Postgres connection string.
# Neon: copy the pooled connection string from your Neon project's dashboard.
# Local without Docker: `pnpm db:local` prints a URL you can paste here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js. Generate a secret with `pnpm dlx auth secret` or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
AUTH_SECRET=""

# Optional until deploy. Without these, magic links print to the terminal (dev only).
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Hatian <login@example.com>"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
