# Postgres. Locally without Docker: run `pnpm db:local` (real Postgres 17) and
# use postgresql://postgres:postgres@localhost:5433/hatian
# Neon (production): DATABASE_URL is the pooled connection string (host has
# "-pooler"); DATABASE_URL_UNPOOLED is the direct one, used for migrations and
# live updates (LISTEN). Leave UNPOOLED empty when DATABASE_URL is direct.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED=""

# Auth.js. Generate a secret with `npx auth secret` or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
AUTH_SECRET=""

# Google sign-in: an OAuth client from Google Cloud Console, with the redirect
# URI https://YOUR-SITE/api/auth/callback/google. Set both or neither.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email magic links via Resend. Without a key, links print to the terminal in
# development and email sign-in is off in production.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Hatian <login@example.com>"

# Required outside Vercel (e.g. `pnpm start` locally, CI, Railway).
AUTH_TRUST_HOST="true"

# Set to "false" to hide the "Try the demo account" button.
AUTH_DEMO_ENABLED="true"
